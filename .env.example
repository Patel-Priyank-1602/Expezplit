# ──────────────────────────────────────────────────────────────────────
# Expezplit — Environment Variables Template
# ──────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env with real credentials to version control.
# ──────────────────────────────────────────────────────────────────────

# ── Gmail SMTP (for email notifications) ─────────────────────────────
EMAIL=your-email@gmail.com
APP_PASSWORD=your-gmail-app-password

# ── Redis ────────────────────────────────────────────────────────────
# Used by: api-gateway, sse-gateway, worker, email-service
# Default: redis://localhost:6379 (matches docker-compose redis service)
REDIS_URL=redis://redis:6379

# ── Rate Limiting ────────────────────────────────────────────────────
# Requests per duration window (per user/IP)
RATE_LIMIT_POINTS=50
RATE_LIMIT_DURATION=60

# ── Exchange Rate API ────────────────────────────────────────────────
EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key
FX_BASE_CURRENCY=INR

# ── Kafka (optional — uncomment when enabling Kafka) ─────────────────
# KAFKA_BROKERS=kafka:9092

# ── Sentry Error Tracking (optional) ────────────────────────────────
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id
# SENTRY_TRACES_SAMPLE_RATE=0.2

# ── Service Ports ────────────────────────────────────────────────────
# These default values match docker-compose.yml
# PORT=4000          # API Gateway
# SSE_PORT=4001      # SSE Gateway
# DASHBOARD_PORT=9100 # Bull Board dashboard

# ── Supabase (frontend — set in frontend/.env.local) ────────────────
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...
# VITE_EXCHANGE_RATE_API_KEY=your-key
# VITE_EMAIL_API_URL=http://localhost:4000
